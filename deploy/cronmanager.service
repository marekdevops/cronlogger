[Unit]
Description=CronManager Web Application (Node.js)
Documentation=file:///opt/cronmanager/README.md
After=network.target
Requires=network.target

[Service]
Type=simple
User=cronmanager
Group=cronmanager
WorkingDirectory=/opt/cronmanager

# RHEL 8/9 — node dostępny jako /usr/bin/node (AppStream)
# RHEL 7   — install.sh generuje ten plik z SCL env vars i ścieżką /opt/rh/rh-nodejsXX/...
Environment="NODE_ENV=production"

ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal

# Hardening procesu (kompatybilne z RHEL 7/8/9)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
